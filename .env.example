# ============ 公共配置(所有服务共享) ============
NODE_ENV=development
APP_NAME=api-gateway

# JWT 签名密钥(生产环境务必用强随机值并通过密钥管理服务注入)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=3600s

# ============ 微服务传输层 ============
# orders 服务监听 Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# billing 服务监听 TCP
BILLING_TCP_PORT=4001

# ============ 数据层 ============
# 本示例使用内存存储;接入真实数据库时在此配置连接串
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=nestjs_microservices

# ============ 任务队列(BullMQ,复用 Redis)============
# 订单超时未支付自动取消的延迟秒数(演示可调小,如 10)
ORDER_AUTO_CANCEL_SECONDS=1800

# ============ RabbitMQ(点对点消息队列)============
# docker compose up -d rabbitmq 后使用默认 guest/guest 即可
RABBITMQ_URL=amqp://localhost:5672
