{
  "name": "nestjs-microservices-shared",
  "version": "1.0.0",
  "description": "NestJS 微服务公共模块抽离实战仓库(monorepo + shared library)",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build -p tsconfig.build.json",
    "start": "nest start",
    "start:gateway": "nest start api-gateway",
    "start:orders": "nest start orders",
    "start:billing": "nest start billing",
    "start:dev:gateway": "nest start api-gateway --watch",
    "start:dev:orders": "nest start orders --watch",
    "start:dev:billing": "nest start billing --watch",
    "lint": "eslint \"{src,apps,libs}/**/*.ts\"",
    "format": "prettier --write \"{src,apps,libs}/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepare": "husky",
    "commit": "cz"
  },
  "config": {
    "commitizen": {
      "path": "cz-git"
    }
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/microservices": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/terminus": "^11.0.0",
    "bullmq": "^6.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@nestjs/cli": "^11.0.2",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "commitizen": "^4.3.2",
    "cz-git": "^1.13.2",
    "husky": "^9.1.7",
    "prettier": "^3.4.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.0"
  }
}
