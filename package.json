{
  "name": "nestjs-microservices-shared",
  "version": "1.0.0",
  "description": "NestJS 微服务公共模块抽离实战仓库(monorepo + shared library)",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "pnpm prisma:generate && nest build -p tsconfig.build.json",
    "start": "nest start",
    "start:gateway": "nest start api-gateway",
    "start:orders": "nest start orders",
    "start:billing": "nest start billing",
    "start:dev:gateway": "nest start api-gateway --watch",
    "start:dev:orders": "nest start orders --watch",
    "start:dev:billing": "nest start billing --watch",
    "lint": "eslint \"{src,apps,libs}/**/*.ts\"",
    "format": "prettier --write \"{src,apps,libs}/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepare": "husky",
    "commit": "cz",
    "typeorm": "typeorm-ts-node-commonjs -d apps/orders/typeorm.config.ts",
    "prisma:generate": "cd apps/orders && prisma generate",
    "prisma:migrate": "cd apps/orders && prisma migrate dev",
    "prisma:studio": "cd apps/orders && prisma studio",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:generate": "npm run typeorm -- migration:generate apps/orders/src/migrations/NewMigration",
    "migration:revert": "npm run typeorm -- migration:revert"
  },
  "config": {
    "commitizen": {
      "path": "cz-git"
    }
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/microservices": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.3",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@prisma/client-runtime-utils": "^7.9.1",
    "amqp-connection-manager": "^5.0.0",
    "bullmq": "^6.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@nestjs/cli": "^11.0.2",
    "@types/amqplib": "^0.10.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "amqplib": "^2.0.1",
    "commitizen": "^4.3.2",
    "cz-git": "^1.13.2",
    "husky": "^9.1.7",
    "prettier": "^3.4.0",
    "prisma": "^7.9.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.0"
  }
}
